# Copy to `.env` at the repo root. Supabase CLI reads this when you run `supabase start`.

# --- Database (required) ---
# Migration superuser. Local Supabase default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Choose a strong password, then run `pnpm db:provision-api-role`.
API_DB_PASSWORD=

# tRPC server only. Must use the castly_api role (RLS bypass).
DATABASE_API_URL=

# --- Supabase Auth (required for API sign-in) ---
SUPABASE_URL=http://127.0.0.1:54321
# From `supabase status` after `supabase start` (secret / service role key).
SUPABASE_SECRET_KEY=

# --- Auth delivery (required for local email OTP) ---
# Resend SMTP — supabase/config.toml reads this at `supabase start`.
RESEND_API_KEY=

# Standard Webhooks format. Required in .env for config.toml even if SMS hook is off.
# Example: echo "v1,whsec_$(openssl rand -base64 32)"
SEND_SMS_HOOK_SECRETS=

# --- Termii (optional — phone/SMS hook disabled in config) ---
TERMII_API_KEY=
TERMII_SENDER_ID=Castly
TERMII_BASE_URL=https://api.ng.termii.com

# --- Mobile (optional; prefer apps/mobile/.env for EXPO_PUBLIC_*) ---
EXPO_PUBLIC_API_URL=

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_PROBE=
SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_RELEASE=
