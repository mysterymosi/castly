# Copy to `.env` at the repo root. Supabase CLI reads this when you run `supabase start`.

# --- Database (required) ---
# Migration superuser. Local Supabase default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Choose a strong password, then run `pnpm db:provision-api-role`.
API_DB_PASSWORD=

# tRPC server only. Must use the castly_api role (RLS bypass).
DATABASE_API_URL=

# --- Supabase Auth (required for API sign-in) ---
SUPABASE_URL=http://127.0.0.1:54321
# From `supabase status` after `supabase start` (secret / service role key).
SUPABASE_SECRET_KEY=

# --- Auth delivery (required for local email OTP) ---
# Resend SMTP — supabase/config.toml reads this at `supabase start`.
RESEND_API_KEY=

# Standard Webhooks format. Required in .env for config.toml even if SMS hook is off.
# Example: echo "v1,whsec_$(openssl rand -base64 32)"
SEND_SMS_HOOK_SECRETS=

# --- Termii (optional — phone/SMS hook disabled in config) ---
TERMII_API_KEY=
TERMII_SENDER_ID=Castly
TERMII_BASE_URL=https://api.ng.termii.com

# --- Mobile (optional; prefer apps/mobile/.env for EXPO_PUBLIC_*) ---
EXPO_PUBLIC_API_URL=

# --- Media pipeline (M2.5) ---
# `local` simulates uploads via /hooks/media/upload (default when no provider is configured).
# `remote` uses real providers: images per CASTLY_IMAGE_PROVIDER, video on Mux.
CASTLY_MEDIA_BACKEND=local
# Images: `supabase` (Storage, temporary — no resizing) or `cf_images`. Defaults to supabase.
# Run `pnpm media:supabase-setup` once per project to create the bucket.
CASTLY_IMAGE_PROVIDER=supabase
# Optional. Bucket name (default `media`).
SUPABASE_MEDIA_BUCKET=
# Optional. Storage origin phones/browsers use when SUPABASE_URL is loopback (e.g. http://<LAN IP>:54321).
SUPABASE_PUBLIC_URL=
CASTLY_PUBLIC_API_URL=http://127.0.0.1:3001
# Standard Webhooks secret for provider-ready callbacks (local + tests).
MEDIA_WEBHOOK_SECRETS=v1,whsec_change_me
# Mux video (direct upload + webhooks).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Optional CORS origin for Mux direct uploads (defaults to *)
MUX_CORS_ORIGIN=

# Cloudflare Images (used when CASTLY_IMAGE_PROVIDER=cf_images; video uses Mux above).
# Run: pnpm cf:media-setup (after CF_ACCOUNT_ID + CF_API_TOKEN).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGES_ACCOUNT_HASH=

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_PROBE=
SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_RELEASE=

# --- Web integration (API side) ---
# The web app's own env lives in apps/web/.env.local (see apps/web/.env.example).
# Same value as the web app's: identifies the web server so its portfolio reads get their own
# rate-limit bucket. Generate: openssl rand -hex 32
CASTLY_WEB_API_KEY=
# The API calls ${CASTLY_WEB_URL}/api/revalidate with this secret after talent changes so cached
# public pages refresh immediately. Unset = no calls; pages refresh within their 60s ISR window.
CASTLY_WEB_URL=http://localhost:3000
CASTLY_REVALIDATE_SECRET=
