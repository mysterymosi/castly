# Optional. Expo inlines EXPO_PUBLIC_* at bundle time. Restart Metro after changes.
# Leave EXPO_PUBLIC_API_URL empty to derive the API host from the dev server (LAN IP).

EXPO_PUBLIC_API_URL=

# Same Sentry project as the API, or a dedicated mobile project.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_RELEASE=
