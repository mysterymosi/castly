# Copy to apps/web/.env.local. Next reads this folder's env files only, not the repo-root .env.
# NEXT_PUBLIC_* values are inlined at `next build`: rebuild after changing them.

# Public origin for canonical URLs, og:url, og:image, and the sitemap
# (https://castly.app in production; a tunnel URL when testing link previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base the Next.js server calls for public portfolios.
CASTLY_API_URL=http://127.0.0.1:3001

# Shared with the API (repo-root .env); set the same value on both sides or leave both unset.
# Sent so the web server's portfolio reads get their own rate-limit bucket.
# Generate: openssl rand -hex 32
CASTLY_WEB_API_KEY=
# Accepted on POST /api/revalidate so the API can refresh cached portfolio pages.
CASTLY_REVALIDATE_SECRET=
